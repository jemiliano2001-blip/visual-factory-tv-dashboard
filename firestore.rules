// REFERENCIA — este archivo NO se despliega desde el Dashboard.
// La base (default) de smv-brain la comparten Dashboard y SMV Vision; las reglas vigentes se despliegan desde
// apps/smv-vision/firestore.rules, que incluye una copia fiel del bloque company_configs de aquí.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Usuarios reales (email/password o Google) — excluye anónimos
    function isRealUser() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Correo verificado: Google siempre lo es; Email/Password solo tras verificación
    function isVerifiedUser() {
      return isRealUser() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.admin == true;
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    function isValidString(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    function isTimestamp(field) {
      return request.resource.data[field] is timestamp;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidCompanyConfig() {
      let allowedFields = ['company_name', 'delivery_schedule', 'updatedAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(allowedFields) &&
             isValidString('company_name', 1, 100) &&
             isValidString('delivery_schedule', 1, 500) &&
             isTimestamp('updatedAt');
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /company_configs/{configId} {
      allow read: if isRealUser();
      allow create: if isAdmin() && isValidCompanyConfig();
      allow update: if isAdmin() && isValidCompanyConfig();
      allow delete: if isAdmin();
    }

    // Configuración por cuenta: cada uid lee y escribe solo su documento (campos exactos).
    function isValidUserSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly(['startView', 'followedClients', 'print', 'appearance', 'updatedAt'])
          && d.keys().hasAll(['startView', 'followedClients', 'print', 'appearance', 'updatedAt'])
          && d.startView in ['company', 'toolcrib', 'requests', 'config']
          && d.followedClients is list && d.followedClients.size() <= 10
          && d.print is map && d.print.keys().hasOnly(['copies', 'boardTicket'])
          && d.print.keys().hasAll(['copies', 'boardTicket'])
          && d.print.copies is int && d.print.copies >= 1 && d.print.copies <= 5
          && d.print.boardTicket is bool
          && d.appearance is map && d.appearance.keys().hasOnly(['theme', 'density'])
          && d.appearance.keys().hasAll(['theme', 'density'])
          && d.appearance.theme in ['dark', 'light']
          && d.appearance.density in ['comfortable', 'compact']
          && d.updatedAt is timestamp;
    }
    match /user_settings/{uid} {
      allow read: if isRealUser() && request.auth.uid == uid;
      allow create, update: if isRealUser() && request.auth.uid == uid && isValidUserSettings();
    }

    // Las órdenes ahora viven en Odoo. Los datos históricos de estas
    // colecciones se conservan en Firestore pero quedan inaccesibles.
    match /work_orders/{orderId} {
      allow read, write: if false;
    }

    match /work_orders_history/{historyId} {
      allow read, write: if false;
    }
  }
}
