{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx watch server.ts",
    "start": "tsx server.ts",
    "dev:full": "npx concurrently -n \"VITE,ODOO\" -c \"cyan,magenta\" \"npm run dev\" \"npm run server\"",
    "dev:alt": "npx concurrently -n \"VITE,ODOO\" \"vite --port=3010 --host=0.0.0.0\" \"npm run server\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"shared/**/*.test.ts\"",
    "test:tv-page-packing": "tsx --test src/utils/tvPagePacking.test.ts",
    "test:voice-risk": "tsx --test src/services/voiceRisk.test.ts",
    "test:voice-stream": "tsx --test shared/geminiSpeechStream.test.ts src/services/speechStream.test.ts src/services/voiceAcknowledgement.test.ts",
    "test:ops-remediation": "tsx --test src/services/cardPresentation.test.ts src/services/companyConfigGuards.test.ts src/services/rotationPolicy.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^1.45.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.10.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "stream-browserify": "^3.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
