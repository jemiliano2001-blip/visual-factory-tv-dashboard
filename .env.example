# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────
# ODOO API — Credenciales del servidor de Odoo
# ─────────────────────────────────────────────
# URL base de tu instancia Odoo (sin barra final)
ODOO_URL="https://tu-instancia.odoo.com"

# Nombre exacto de la base de datos Odoo
ODOO_DB="nombre_base_datos"

# Usuario y contraseña de Odoo (con permisos de lectura en sale.order)
ODOO_USERNAME="usuario@empresa.com"
ODOO_PASSWORD="tu_contraseña_odoo"

# Puerto en que corre el servidor Express proxy (por defecto 3001)
ODOO_PROXY_PORT=3001

# Webhooks para alertas de Discord
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_CRITICOS=
NOTIFICATIONS_ENABLED=true

# Secreto compartido para proteger el proxy en producción.
# El servidor (server.ts) lo lee como API_SECRET; el frontend lo envía como
# VITE_API_SECRET en el header Authorization. Deben tener el MISMO valor.
# En localhost el proxy no lo exige (bypass de desarrollo).
API_SECRET="un_secreto_largo_y_aleatorio"
VITE_API_SECRET="un_secreto_largo_y_aleatorio"

# Opcional: URL base del proxy de Odoo si está desplegado en otro host
# (sin barra final). Vacío/omitido = mismo origen (Vite reenvía /api).
# VITE_ODOO_PROXY_URL="https://mi-proxy.example.com"

# API Key adicional (si aplica)
API_KEY="your_api_key_here"