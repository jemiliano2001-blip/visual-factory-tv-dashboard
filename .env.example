# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────
# ODOO API — Credenciales del servidor de Odoo
# ─────────────────────────────────────────────
# URL base de tu instancia Odoo (sin barra final)
ODOO_URL="https://tu-instancia.odoo.com"

# Nombre exacto de la base de datos Odoo
ODOO_DB="nombre_base_datos"

# Usuario y contraseña de Odoo (con permisos de lectura en sale.order)
ODOO_USERNAME="usuario@empresa.com"
ODOO_PASSWORD="tu_contraseña_odoo"

# Puerto en que corre el servidor Express proxy (por defecto 3001)
ODOO_PROXY_PORT=3001

# Webhooks para alertas de Discord
DISCORD_WEBHOOK_URL=              # canal #ordenes (eventos) — requerido
DISCORD_WEBHOOK_URL_CRITICOS=     # canal #criticas — opcional (fallback al principal)
DISCORD_WEBHOOK_URL_REPORTES=     # canal #reportes — opcional (fallback al principal)
DISCORD_ROLE_GENERAL=             # rol opcional para mencionar en reportes
DISCORD_LARGE_ORDER_LINES=5       # umbral de líneas para "orden grande"
DASHBOARD_URL=https://dashboardsmv.web.app
NOTIFICATIONS_ENABLED=true
# Días hábiles sin movimiento en remisiones antes de disparar alerta de orden estancada (default 3)
STALL_THRESHOLD_DAYS=3

# Firebase API key para verificar ID tokens en el servidor (producción).
# En desarrollo se lee automáticamente de firebase-applet-config.json.
# En producción cópiala de firebase-applet-config.json o de Firebase Console.
FIREBASE_API_KEY=""

# Solo desarrollo local: omitir verificación de token en conexiones desde 127.0.0.1/::1.
# NUNCA activar en producción detrás de Cloudflare Tunnel (el túnel llega como localhost).
# DEV_AUTH_BYPASS=true

# Opcional: URL base del proxy de Odoo si está desplegado en otro host
# (sin barra final). Vacío/omitido = mismo origen (Vite reenvía /api).
# VITE_ODOO_PROXY_URL="https://mi-proxy.example.com"